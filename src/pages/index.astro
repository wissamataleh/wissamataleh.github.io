---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  SITE,
  EXPERIENCE,
  CERTIFICATIONS,
  EDUCATION,
  SKILLS,
  PROJECTS,
  IMPACT,
  CONTACT,
} from "../data/site";
---
<BaseLayout title={`${SITE.handle} — ${SITE.role}`}>
  <section class="deck-page" data-page="home">
    <article class="content-panel">
      <p class="kicker">WISSAM ATALEH // AMMAN, JORDAN</p>
      <h1>{SITE.role}</h1>
      <p class="tagline">{SITE.tagline}</p>
      <div class="hairline" />
      <dl class="stat-strip">
        {SITE.stats.map((stat) => (
          <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
        ))}
      </dl>
      <p class="hint">SCROLL TO NAVIGATE — OR AIM &amp; CLICK A NODE.</p>
    </article>
  </section>

  <section class="deck-page" data-page="impact">
    <section class="content-panel">
      <p class="kicker">02 / IMPACT</p>
      <div class="metric-grid">
        {IMPACT.stats.map((cell) => (
          <div class="metric-cell">
            <span class="metric-label">{cell.label}</span>
            <span class="metric-value">{cell.value}</span>
          </div>
        ))}
      </div>
      <div class="hairline" />
      <ul class="role-points">
        {IMPACT.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </section>
  </section>

  <section class="deck-page" data-page="experience">
    <section class="content-panel">
      <p class="kicker">03 / EXPERIENCE</p>
      {EXPERIENCE.map((role) => (
        <article class="role">
          <div class="role-head">
            <h2>{role.title}</h2>
            <p class="role-meta">{role.company} — {role.period}</p>
            <p class="role-stack">{role.stack.join(" / ")}</p>
          </div>
          <ul class="role-points">
            {role.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))}
      <article class="role">
        <div class="role-head">
          <h2>Certifications</h2>
          <ul class="role-points">
            {CERTIFICATIONS.map((cert) => (
              <li>{cert.name} — <span class="role-meta">{cert.issuer}, {cert.year}</span></li>
            ))}
          </ul>
        </div>
      </article>
      <article class="role">
        <div class="role-head">
          <h2>Education</h2>
          <ul class="role-points">
            {EDUCATION.map((edu) => (
              <li>{edu.degree} — <span class="role-meta">{edu.school}, {edu.period}</span></li>
            ))}
          </ul>
        </div>
      </article>
    </section>
  </section>

  <section class="deck-page" data-page="platform">
    <section class="content-panel">
      <p class="kicker">04 / PLATFORM &amp; SKILLS</p>
      {SKILLS.map((group) => (
        <div class="skill-group">
          <h2>{group.name}</h2>
          <ul class="skill-tags">
            {group.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </section>

  <section class="deck-page" data-page="projects">
    <section class="content-panel">
      <p class="kicker">05 / PROJECTS</p>
      {PROJECTS.map((project) => (
        <article class="project">
          <div class="project-head">
            <h2>{project.name}</h2>
            <span class="project-status">{project.status}</span>
          </div>
          <p class="project-summary">{project.summary}</p>
          <p class="project-stack">{project.stack.join(" / ")}</p>
        </article>
      ))}
    </section>
  </section>

  <section class="deck-page" data-page="contact">
    <section class="content-panel">
      <p class="kicker">06 / CONTACT</p>
      <p class="tagline">{CONTACT.availability}</p>
      <dl class="contact-list">
        <div><dt>EMAIL</dt><dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd></div>
        <div><dt>LOCATION</dt><dd>{SITE.location}</dd></div>
        <div><dt>GITHUB</dt><dd><a href={CONTACT.github} target="_blank" rel="noreferrer">{CONTACT.github}</a></dd></div>
        <div><dt>LINKEDIN</dt><dd><a href={CONTACT.linkedin} target="_blank" rel="noreferrer">{CONTACT.linkedin}</a></dd></div>
        <div><dt>CV</dt><dd><a href={CONTACT.cv} download rel="noreferrer">DOWNLOAD PDF — WISSAM ATALEH</a></dd></div>
      </dl>
    </section>
  </section>
</BaseLayout>
